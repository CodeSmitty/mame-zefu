<div class="mx-auto md:w-4/5 w-full form-container lg:px-20 p-5">
  <h1 class="font-bold text-2xl lg:text-4xl text-secondary text-start">Download Recipes</h1>

  <p class="my-5">Download a ZIP archive of your recipes and attached images.</p>

  <%= link_to archive_download_file_recipes_path, data: { turbo: false }, class: "inline-flex items-center rounded-lg py-2 px-3 bg-white hover:bg-secondary text-secondary hover:text-white border border-secondary font-medium cursor-pointer" do %>
    <%= render_icon "mini/arrow_down_tray", classes: "me-1" %> Download
  <% end %>
</div>
